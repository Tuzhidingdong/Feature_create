{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Feature_create/blob/main/contracts/worker-a.schema.json",
  "title": "Worker A — Source-centric Discovery Output",
  "description": "Paper/SI source-centric result feature discovery and individual result-value candidates. Persistent IDs are assigned later by Python.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "worker_role",
    "paper_id",
    "coverage",
    "feature_observations",
    "result_records",
    "unresolved_items"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_role": {
      "const": "source_discovery"
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverageItem"
      }
    },
    "feature_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featureObservation"
      }
    },
    "result_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resultRecord"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedItem"
      }
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "main_text",
            "main_table",
            "main_figure",
            "main_figure_caption",
            "si_text",
            "si_table",
            "si_figure",
            "si_figure_caption",
            "supporting_dataset",
            "other"
          ]
        },
        "locator": {
          "type": "object",
          "additionalProperties": true
        },
        "quote_or_cell_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_status": {
          "enum": [
            "unverified",
            "verified_text",
            "verified_table_cell",
            "verified_digitization",
            "visual_only",
            "unreadable",
            "not_applicable"
          ]
        }
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "source_id",
        "scope_id",
        "status"
      ],
      "properties": {
        "component": {
          "enum": [
            "main_text",
            "main_tables",
            "main_figures",
            "si_text",
            "si_tables",
            "si_figures",
            "supporting_datasets",
            "other"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "description": "Exact assigned review scope ID from the task coverage checklist."
        },
        "status": {
          "enum": [
            "fully_reviewed",
            "partially_reviewed",
            "not_accessible",
            "not_present",
            "not_applicable"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "featureObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_observation_id",
        "source_id",
        "raw_feature_name",
        "variable_role",
        "result_type",
        "evidence_refs"
      ],
      "properties": {
        "candidate_observation_id": {
          "type": "string",
          "minLength": 1,
          "description": "Task-local reference only; Python assigns the persistent observation_id."
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_feature_name": {
          "type": "string",
          "minLength": 1
        },
        "raw_definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "reported_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "reported_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_type": {
          "enum": [
            "measured",
            "calculated",
            "derived",
            "simulated",
            "model_output",
            "not_stated",
            "uncertain"
          ]
        },
        "variable_role": {
          "enum": [
            "result_feature",
            "condition_only",
            "sample_descriptor",
            "uncertain"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "contextFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_label",
        "raw_value",
        "context_role",
        "evidence_refs"
      ],
      "properties": {
        "raw_label": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_role": {
          "enum": [
            "sample_identity",
            "condition",
            "time_or_cycle",
            "protocol",
            "statistical_scope",
            "other"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    },
    "resultRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_record_id",
        "candidate_observation_id",
        "source_id",
        "raw_value",
        "value_extraction_status",
        "result_type",
        "evidence_refs"
      ],
      "properties": {
        "candidate_record_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_observation_id": {
          "type": "string",
          "minLength": 1,
          "description": "Must reference a candidate_observation_id in feature_observations."
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {
          "type": "string",
          "minLength": 1,
          "description": "Exact reported string; preserve symbols, inequalities, ranges, and significant figures."
        },
        "numeric_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_extraction_status": {
          "enum": [
            "exact_text",
            "exact_table_cell",
            "digitized",
            "visual_only",
            "not_extractable"
          ]
        },
        "reported_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_type": {
          "enum": [
            "measured",
            "calculated",
            "derived",
            "simulated",
            "model_output",
            "not_stated",
            "uncertain"
          ]
        },
        "statistic_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "replicate_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sample_identity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextFact"
          }
        },
        "condition_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextFact"
          }
        },
        "time_cycle_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextFact"
          }
        },
        "protocol_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextFact"
          }
        },
        "other_context_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextFact"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "context_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "unresolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_type",
        "description",
        "evidence_refs"
      ],
      "properties": {
        "item_type": {
          "enum": [
            "ambiguous_feature",
            "uncertain_value",
            "missing_context",
            "unreadable_figure",
            "inaccessible_source",
            "table_alignment_uncertain",
            "possible_duplicate",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "suggested_review": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_candidate_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_candidate_observation_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
