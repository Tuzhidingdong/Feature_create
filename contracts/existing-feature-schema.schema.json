{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Feature_create/blob/main/contracts/existing-feature-schema.schema.json",
  "title": "Imported Existing Feature Schema",
  "description": "Normalized, source-preserving representation of the user's pre-existing result_feature_list.txt or equivalent schema file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_file",
    "source_sha256",
    "source_format",
    "features"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1"
    },
    "source_file": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_format": {
      "enum": [
        "tsv",
        "json",
        "text_blocks"
      ]
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "FEATURE_ID",
        "CANONICAL_NAME",
        "ALIASES",
        "DEFINITION",
        "RESULT_TYPE",
        "UNITS_AND_DIMENSION",
        "MEASUREMENT_METHODS",
        "CALCULATION_METHODS"
      ],
      "properties": {
        "FEATURE_ID": {
          "type": "string",
          "minLength": 1
        },
        "CANONICAL_NAME": {
          "type": "string",
          "minLength": 1
        },
        "ALIASES": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "DEFINITION": {
          "type": [
            "string",
            "null"
          ]
        },
        "RESULT_TYPE": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "UNITS_AND_DIMENSION": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reported_units",
            "dimensions"
          ],
          "properties": {
            "reported_units": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "dimensions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "MEASUREMENT_METHODS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "CALCULATION_METHODS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "STANDARDIZATION_NOTES": {
          "type": [
            "string",
            "null"
          ]
        },
        "COMPARABILITY_NOTES": {
          "type": [
            "string",
            "null"
          ]
        },
        "RAW_FIELDS": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}