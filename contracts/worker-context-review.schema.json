{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Feature_create/blob/main/contracts/worker-context-review.schema.json",
  "title": "Feature_create targeted cross-chunk context review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_type",
    "task_id",
    "paper_id",
    "unresolved_id",
    "record_id",
    "decision",
    "rationale",
    "review_evidence_refs",
    "context_facts"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1"
    },
    "task_type": {
      "const": "cross_chunk_context"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "unresolved_id": {
      "type": "string",
      "minLength": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "association_confirmed",
        "no_association",
        "insufficient_evidence",
        "conflicting_evidence"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "review_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    },
    "context_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextFact"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "association_confirmed"
          }
        }
      },
      "then": {
        "properties": {
          "context_facts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "no_association",
              "insufficient_evidence",
              "conflicting_evidence"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "context_facts": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_side",
        "source_id",
        "locator",
        "evidence_status"
      ],
      "properties": {
        "evidence_side": {
          "enum": [
            "current",
            "target"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "quote_or_cell_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_status": {
          "enum": [
            "verified_text",
            "verified_table_cell",
            "visual_only",
            "unverified",
            "unreadable"
          ]
        }
      }
    },
    "contextFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_role",
        "raw_label",
        "raw_value",
        "evidence_refs"
      ],
      "properties": {
        "context_role": {
          "enum": [
            "sample_identity",
            "condition",
            "time_or_cycle",
            "protocol",
            "statistical_scope",
            "other"
          ]
        },
        "raw_label": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      }
    }
  }
}
