{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Feature_create/blob/main/contracts/reconciliation.schema.json",
  "title": "Feature_create Semantic Reconciliation Decision",
  "description": "Structured recommendation for a pairwise feature comparison or a feature-to-schema mapping review. Python validates and applies allowed state transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "decision_id",
    "decision_scope",
    "candidate_a_id",
    "candidate_b_id",
    "relationship",
    "recommended_action",
    "rationale",
    "comparison_dimensions",
    "evidence_observation_ids",
    "unresolved_conflicts"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_scope": {
      "enum": [
        "within_paper",
        "cross_paper",
        "existing_schema_mapping"
      ]
    },
    "candidate_a_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_b_id": {
      "type": "string",
      "minLength": 1,
      "description": "For an existing schema mapping review, this may be the existing FEATURE_ID."
    },
    "relationship": {
      "enum": [
        "SAME_FEATURE",
        "RELATED_BUT_DISTINCT",
        "SAME_FAMILY_DIFFERENT_STATISTIC",
        "INSUFFICIENT_EVIDENCE",
        "NOT_A_RESULT_FEATURE",
        "CONDITION_ONLY"
      ]
    },
    "recommended_action": {
      "enum": [
        "merge_candidates",
        "keep_separate",
        "map_to_existing_id",
        "create_new_canonical_feature",
        "exclude_from_feature_registry",
        "request_targeted_review",
        "no_change"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "comparison_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quantity_or_measurand": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition_or_formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalization_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "statistic_or_aggregation": {
          "type": [
            "string",
            "null"
          ]
        },
        "temporal_or_cycle_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_dimension": {
          "type": [
            "string",
            "null"
          ]
        },
        "measurement_or_calculation_method": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_observation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existing_feature_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_required": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recommended_action": {
            "const": "map_to_existing_id"
          }
        },
        "required": [
          "recommended_action"
        ]
      },
      "then": {
        "properties": {
          "existing_feature_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "existing_feature_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "relationship": {
            "const": "INSUFFICIENT_EVIDENCE"
          }
        },
        "required": [
          "relationship"
        ]
      },
      "then": {
        "properties": {
          "recommended_action": {
            "enum": [
              "keep_separate",
              "request_targeted_review",
              "no_change"
            ]
          }
        }
      }
    }
  ]
}